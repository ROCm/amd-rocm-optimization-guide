# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:

- caption: Getting started
  entries:
  - file: conceptual/introduction
  - file: conceptual/introduction/understand
  - file: conceptual/introduction/guidelines
  - file: how-to/multi-gpu-programming

- caption: Performance optimization patterns
  entries:
  - file: patterns/introduction
  - file: patterns/examples/reduction
  - file: patterns/examples/histogram
  - file: patterns/examples/matrix-multiply-optimization

- caption: Compiler builtins
  entries:
  - file: compiler-builtins/introduction
  - file: compiler-builtins/cross-arch/arithmetic-builtins
    subtrees:
    - entries:
      - file: compiler-builtins/cross-arch/arithmetic-ref/sad-builtins
      - file: compiler-builtins/cross-arch/arithmetic-ref/dot-integer-builtins
      - file: compiler-builtins/cross-arch/arithmetic-ref/dot-float-builtins
      - file: compiler-builtins/cross-arch/arithmetic-ref/conversion-packing-builtins
  - file: compiler-builtins/cross-arch/direct-to-lds-builtins
  - file: compiler-builtins/cross-arch/wavefront-builtins
    subtrees:
    - entries:
      - file: compiler-builtins/cross-arch/wavefront-ref/shuffle-builtins
      - file: compiler-builtins/cross-arch/wavefront-ref/dpp-builtins
      - file: compiler-builtins/cross-arch/wavefront-ref/permlane-builtins
      - file: compiler-builtins/cross-arch/wavefront-ref/wave-reduce-builtins
      - file: compiler-builtins/cross-arch/wavefront-ref/vote-builtins
  - file: compiler-builtins/cdna/mfma-builtins
    subtrees:
    - entries:
      - file: compiler-builtins/cdna/dense-mfma-builtins
        subtrees:
        - entries:
          - file: compiler-builtins/cdna/cdna-dense-mfma-builtins
          - file: compiler-builtins/cdna/cdna2-dense-mfma-builtins
          - file: compiler-builtins/cdna/cdna3-dense-mfma-builtins
          - file: compiler-builtins/cdna/cdna4-dense-mfma-builtins
      - file: compiler-builtins/cdna/sparse-mfma-builtins
        subtrees:
        - entries:
          - file: compiler-builtins/cdna/cdna-sparse-mfma-builtins
          - file: compiler-builtins/cdna/cdna3-sparse-mfma-builtins
          - file: compiler-builtins/cdna/cdna4-sparse-mfma-builtins
      - file: compiler-builtins/cdna/cdna4-mfma-lds-builtins
      - file: compiler-builtins/cdna/mfma-common-parameters
  - file: compiler-builtins/rdna/wmma-builtins
    subtrees:
    - entries:
      - file: compiler-builtins/rdna/dense-wmma-builtins
        subtrees:
        - entries:
          - file: compiler-builtins/rdna/rdna3-dense-wmma-builtins
          - file: compiler-builtins/rdna/rdna4-dense-wmma-builtins
      - file: compiler-builtins/rdna/rdna4-sparse-wmma-builtins
