# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:

- caption: Getting started
  entries:
  - file: conceptual/introduction
  - file: conceptual/introduction/understand
  - file: conceptual/introduction/guidelines
  - file: how-to/multi-gpu-programming

- caption: Performance optimization patterns
  entries:
  - file: patterns/introduction
  - file: patterns/examples/reduction
  - file: patterns/examples/histogram
  - file: patterns/examples/matrix-multiply-optimization

- caption: Hardware intrinsics
  entries:
  - file: hardware-intrinsics/introduction
  - file: hardware-intrinsics/cross-arch/arithmetic-intrinsics
    subtrees:
    - entries:
      - file: hardware-intrinsics/cross-arch/arithmetic-ref/sad-intrinsics
      - file: hardware-intrinsics/cross-arch/arithmetic-ref/dot-integer-intrinsics
      - file: hardware-intrinsics/cross-arch/arithmetic-ref/dot-float-intrinsics
      - file: hardware-intrinsics/cross-arch/arithmetic-ref/conversion-packing-intrinsics
  - file: hardware-intrinsics/cross-arch/direct-to-lds-intrinsics
  - file: hardware-intrinsics/cross-arch/warp-intrinsics
    subtrees:
    - entries:
      - file: hardware-intrinsics/cross-arch/warp-ref/shuffle-intrinsics
      - file: hardware-intrinsics/cross-arch/warp-ref/dpp-intrinsics
      - file: hardware-intrinsics/cross-arch/warp-ref/permlane-intrinsics
      - file: hardware-intrinsics/cross-arch/warp-ref/wave-reduce-intrinsics
      - file: hardware-intrinsics/cross-arch/warp-ref/vote-intrinsics
  - file: hardware-intrinsics/cdna/mfma-intrinsics
    subtrees:
    - entries:
      - file: hardware-intrinsics/cdna/dense-mfma-intrinsics
        subtrees:
        - entries:
          - file: hardware-intrinsics/cdna/cdna-dense-mfma-intrinsics
          - file: hardware-intrinsics/cdna/cdna2-dense-mfma-intrinsics
          - file: hardware-intrinsics/cdna/cdna3-dense-mfma-intrinsics
          - file: hardware-intrinsics/cdna/cdna4-dense-mfma-intrinsics
      - file: hardware-intrinsics/cdna/sparse-mfma-intrinsics
        subtrees:
        - entries:
          - file: hardware-intrinsics/cdna/cdna-sparse-mfma-intrinsics
          - file: hardware-intrinsics/cdna/cdna3-sparse-mfma-intrinsics
          - file: hardware-intrinsics/cdna/cdna4-sparse-mfma-intrinsics
      - file: hardware-intrinsics/cdna/cdna4-mfma-lds-intrinsics
      - file: hardware-intrinsics/cdna/mfma-common-parameters
  - file: hardware-intrinsics/rdna/wmma-intrinsics
    subtrees:
    - entries:
      - file: hardware-intrinsics/rdna/dense-wmma-intrinsics
        subtrees:
        - entries:
          - file: hardware-intrinsics/rdna/rdna3-dense-wmma-intrinsics
          - file: hardware-intrinsics/rdna/rdna4-dense-wmma-intrinsics
      - file: hardware-intrinsics/rdna/rdna4-sparse-wmma-intrinsics
